# One Admin key per organization. accounts.json maps each account to the variable
# named here; to add an org, add an entry there and a matching variable below.
#
# REQUIRED: an *Admin* key, not a project key.
# Create at: https://platform.openai.com/settings/organization/admin-keys
# Must be created by an Organization Owner. Starts with sk-admin-...
# A regular sk-proj-... key returns 403 (missing scopes api.usage.read / api.management.read).
OPENAI_ADMIN_KEY=sk-admin-xxxxxxxxxxxxxxxxxxxx

# Second organization (accounts.json -> acct-legacy). Omit if you only have one.
OPENAI_ADMIN_KEY_2=sk-admin-xxxxxxxxxxxxxxxxxxxx

# Optional: restrict CORS to your frontend origin
CORS_ORIGINS=http://localhost:5173

# Optional: serve synthetic data when no admin key is set (default true)
ALLOW_DEMO_MODE=true

# auto-refresh: seconds the backend caches a payload before re-reading OpenAI
CACHE_TTL_SECONDS=30
